# Backend env schema. Copy to .env (real values) — .env.local overrides .env for personal tweaks.
# Both are gitignored; Claude is denied read/write on them by .claude/settings.json.

# Default: SQLite — zero install, the DB is just a file (gitignored). Nothing to start.
DATABASE_URL=sqlite:///./app.db

# Production: hosted Postgres (e.g. Neon free tier) — paste its connection string:
# DATABASE_URL=postgresql+psycopg://user:pass@your-host.neon.tech/dbname
DEBUG=false
